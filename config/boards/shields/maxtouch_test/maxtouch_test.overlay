#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/input_transform.h>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zephyr,console = &cdc_acm_uart;
    };

    // Minimal mock 1-key matrix so ZMK initializes without physical switch matrix wiring
    mock_kscan: kscan {
        compatible = "zmk,kscan-mock";
        columns = <1>;
        rows = <1>;
        events = <0>;
    };

    maxtouch_listener {
        compatible = "zmk,input-listener";
        device = <&touchpad>;
    };

    ext-power {
        status = "disabled";
    };
};

&zephyr_udc0 {
    cdc_acm_uart: cdc_acm_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};

&pro_micro_i2c {
    status = "okay";

    touchpad: maxtouch@4a {
        reg = <0x4a>;
        compatible = "microchip,maxtouch";
        chg-gpios = <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        sensor-height = <91>;
        sensor-width = <156>;
        swap-xy;
        repeat-each-cycle;
    };
};
